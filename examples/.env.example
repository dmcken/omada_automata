# Copy this file to examples/.env and fill in your own values.
# examples/.env is gitignored (matches the repo-wide ".env" rule) -
# never commit real credentials.

OMADA_EMAIL=you@example.com
OMADA_PASSWORD=your-password

# Optional - if unset, walkthrough.py uses the first organization/site
# list_organizations()/get_sites() returns.
OMADA_ORG_ID=
OMADA_SITE_ID=
