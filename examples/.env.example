# Copy this file to examples/.env and fill in your own values.
# examples/.env is gitignored (matches the repo-wide ".env" rule) -
# never commit real credentials.

OMADA_EMAIL=you@example.com
OMADA_PASSWORD=your-password

# Optional - if unset, walkthrough.py uses the first organization/site
# list_organizations()/get_sites() returns.
OMADA_ORG_ID=
OMADA_SITE_ID=

# Optional - only needed if your account has 2FA enabled. The base32
# secret decoded from your authenticator app's setup QR code (its
# otpauth:// URI has a `secret=` query param - e.g. `zbarimg` reads a
# saved QR image straight to that URI). Lets login_with_cache()
# complete 2FA automatically instead of prompting - requires the
# `totp` extra (uv sync --group totp / pip install .[totp]). Treat
# this exactly like a password - anyone with it can generate valid
# codes for your account.
OMADA_TOTP_SECRET=
